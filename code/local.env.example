# Machine-specific overrides.  Copy to local.env and edit; local.env is
# gitignored, so every machine keeps its own paths.
#
#   cp local.env.example local.env
#
# Anything left commented out falls back to the default in env.sh.

# --- AF3 installation --------------------------------------------------------
# Everything AF3 needs lives under one root by default.
#AF3_HOME=/data/af3
#AF3_REPO=/data/af3/alphafold3
#MODEL_DIR=/data/af3/models          # the access-controlled parameters
#DB_DIR=/data/af3/databases          # ~300 GB; put this on an SSD

# Interpreter that can import AF3.  If you installed with `uv sync`, point this
# at the venv rather than activating it:
#AF3_PYTHON=/data/af3/alphafold3/.venv/bin/python

# --- data --------------------------------------------------------------------
#DATASET=/data/benchmarks/final_dataset.csv
# Fold inputs and outputs land here.  Keep it off any synced or network filesystem --
# a full sweep writes tens of thousands of directories.
#WORK_DIR=/data/scratch/sc4001

# --- run parameters ----------------------------------------------------------
#GPUS=0,1                 # default: every GPU nvidia-smi reports
#FOLDS_PER_GPU=2          # 48 GB cards fit several of these small folds at once
#MSA_JOBS=3               # concurrent HMMER jobs; raise with cores and RAM
#SEEDS=2 3
#UNIFIED_MEMORY=1         # only needed above ~5,120 tokens; this project maxes at 871
